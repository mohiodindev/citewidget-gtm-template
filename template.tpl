___SANDBOXED_JS_FOR_WEB_TEMPLATE___

/*
 * CiteWidget chat widget. Contract v1: docs/integrations/embed-contract.md.
 *
 * Sets window.CiteWidgetConfig, then loads the widget script once. Options left empty are not
 * set, so the dashboard settings keep applying (precedence: defaults < dashboard < config).
 */
var injectScript = require('injectScript');
var setInWindow = require('setInWindow');
var logToConsole = require('logToConsole');
var makeString = require('makeString');
var makeInteger = require('makeInteger');

var SCRIPT_URL = 'https://api.citewidget.com/widget/v1/citewidget.js';
var CACHE_TOKEN = 'citewidget-v1';
var DEFAULT_API_URL = 'https://api.citewidget.com';
var DEFAULT_SERVER_URL = 'https://app.citewidget.com';
var MAX_CHAT_DURATION_MINUTES = 120;
var MAX_SUGGESTIONS = 3;
var SUGGESTION_MAX = 200;

var TEXT_LIMITS = {
  title: 80, greeting: 200, botName: 60, primaryColor: 100, surfaceColor: 100,
  launcherLabel: 40, softRefusal: 500, goodbye: 500, handoffReplyTime: 80
};
var ENUMS = {
  colorScheme: ['light', 'dark', 'auto'],
  position: ['bottom-right', 'bottom-left'],
  launcherIcon: ['chat', 'sparkles', 'headset', 'book']
};
var BOOLEANS = ['launcher', 'handoff', 'leadCapture'];

function clean(value, limit) {
  var text = makeString(value === undefined || value === null ? '' : value).trim();
  return text.length > limit ? text.substring(0, limit) : text;
}

function isHttpUrl(value) {
  return value.indexOf('https://') === 0 || value.indexOf('http://') === 0;
}

function withoutTrailingSlashes(value) {
  var end = value.length;
  while (end > 0 && value.substring(end - 1, end) === '/') end--;
  return value.substring(0, end);
}

function urlOrDefault(value, fallback) {
  var url = withoutTrailingSlashes(clean(value, 2048));
  return isHttpUrl(url) ? url : fallback;
}

function suggestionList(value) {
  var parts = clean(value, 1000).split('|');
  var items = [];
  for (var i = 0; i < parts.length && items.length < MAX_SUGGESTIONS; i++) {
    var item = clean(parts[i], SUGGESTION_MAX);
    if (item) items.push(item);
  }
  return items;
}

function buildConfig(data) {
  var config = {
    workspaceKey: clean(data.workspaceKey, 130),
    apiUrl: urlOrDefault(data.apiUrl, DEFAULT_API_URL),
    serverUrl: urlOrDefault(data.serverUrl, DEFAULT_SERVER_URL)
  };
  var name;
  for (name in TEXT_LIMITS) {
    var text = clean(data[name], TEXT_LIMITS[name]);
    if (text) config[name] = text;
  }
  for (name in ENUMS) {
    var choice = clean(data[name], 40);
    if (ENUMS[name].indexOf(choice) >= 0) config[name] = choice;
  }
  for (var b = 0; b < BOOLEANS.length; b++) {
    var flag = clean(data[BOOLEANS[b]], 5);
    if (flag === 'true') config[BOOLEANS[b]] = true;
    if (flag === 'false') config[BOOLEANS[b]] = false;
  }
  var iconUrl = clean(data.launcherIconUrl, 2048);
  if (iconUrl.indexOf('https://') === 0) config.launcherIconUrl = iconUrl;
  var suggestions = suggestionList(data.suggestions);
  if (suggestions.length) config.suggestions = suggestions;
  var minutes = makeInteger(clean(data.chatDuration, 3));
  if (minutes >= 0 && minutes <= MAX_CHAT_DURATION_MINUTES) config.chatDuration = minutes;
  return config;
}

var config = buildConfig(data);
if (config.workspaceKey.indexOf('pk_') !== 0 || config.workspaceKey.length < 8) {
  logToConsole('CiteWidget: the workspace key must be the public key that starts with pk_.');
  data.gtmOnFailure();
  return;
}

setInWindow('CiteWidgetConfig', config, true);
injectScript(SCRIPT_URL, data.gtmOnSuccess, function () {
  logToConsole('CiteWidget: the widget script could not be loaded.');
  data.gtmOnFailure();
}, CACHE_TOKEN);


